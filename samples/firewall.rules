# Sample firewall config that intentionally contains several high-risk rules (do not use in production)
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]

# Allow the management interface to be reached from any source
-A INPUT -p tcp --dport 22 -j ACCEPT
-A INPUT -p tcp --dport 3306 -j ACCEPT
-A INPUT -p tcp --dport 6379 -j ACCEPT

# Wide-open rule with no source restriction
-A INPUT -s 0.0.0.0/0 -j ACCEPT
-A FORWARD -j ACCEPT

# Drops traffic without logging it
-A INPUT -p tcp --dport 8080 -j DROP
COMMIT

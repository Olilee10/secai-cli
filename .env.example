# SecAI environment variable example: copy to .env and fill in your own values
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)

# Required: DeepSeek API key (not needed with --dry-run)
DEEPSEEK_API_KEY=sk-your-key-here

# Optional: model and endpoint (defaults: deepseek-chat / https://api.deepseek.com)
#DEEPSEEK_MODEL=deepseek-chat
#DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: disable coloured output (useful for files or CI logs)
#SECAI_NO_COLOR=1
